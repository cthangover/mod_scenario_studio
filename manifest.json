{
  "id": "scenario_studio",
  "name": "Scenario Studio",
  "version": "0.1.0",
  "author": "ct",
  "description": "A dock beside the running game that pauses, steps and edits the playing scenario: breakpoints, restarts with state rollback, live edits into a mod or a per-game layer.",
  "category": "tools, editor",
  "sources": [
    "src/**/*.cs"
  ],
  "depends": ["ui_base>=1", "dialog_base>=1"],
  "ui": [
    {
      "id": "studio",
      "kind": "panel",
      "slot": "ModBeforeUIPanel",
      "scene_path": "scenes/studio_panel.tscn",
      "button": { "icon": "studio", "locale": "studio/title", "index": 90 },
      "priority": 30
    }
  ],
  "test_suites": [
    {"id": "live", "activate": ["--itest=studio_live"]}
  ]
}
