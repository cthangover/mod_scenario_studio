{
  "id": "scenario_studio",
  "name": "Scenario Studio",
  "version": "0.1.0",
  "author": "ct",
  "description": "A dock beside the running game that pauses, steps and edits the playing scenario: breakpoints, restarts with state rollback, live edits into a mod or a per-game layer.",
  "categories": ["tools", "editor"],
  "sources": [
    "src/**/*.cs"
  ],
  "test_sources": ["tests/*.cs"],
  "depends": [
    "ui_base>=0.1.0",
    "dialog_base>=0.1.0",
    "scenario_tools_base>=0.1.0"
  ],
  "ui": [
    {
      "id": "studio",
      "kind": "panel",
      "slot": "ModBeforeUIPanel",
      "scene_path": "scenes/studio_panel.tscn",
      "button": {
        "icon": "studio",
        "locale": "studio/title",
        "index": 90
      },
      "priority": 30
    }
  ],
  "test_suites": [
    {
      "id": "live",
      "activate": [
        "--itest=studio_live"
      ]
    },
    {
      "id": "projection",
      "activate": [
        "--itest=studio_projection"
      ]
    }
  ]
}
